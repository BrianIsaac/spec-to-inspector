# Every setting, with its default; copy what you change to `.env`. Read by
# spec_to_inspector.settings.Settings, with the environment taking precedence.

# Where the data, the weights and the runs are kept.
# SPEC_TO_INSPECTOR_DATA_DIR=data
# SPEC_TO_INSPECTOR_MODELS_DIR=models
# SPEC_TO_INSPECTOR_RUNS_DIR=runs
# SPEC_TO_INSPECTOR_VISA_URL=https://amazon-visual-anomaly.s3.us-west-2.amazonaws.com/VisA_20220922.tar
# A directory of docling's models, for a machine without network.
# SPEC_TO_INSPECTOR_DOCLING_ARTIFACTS_DIR=

# What the anomaly model runs on: cuda, xpu (an Intel card, and Stage II's protocol) or cpu.
# SPEC_TO_INSPECTOR_DEVICE=cuda

# The judge's server. The laptop's llama.cpp build:
# SPEC_TO_INSPECTOR_LLAMA_CPP_DIR=models/llama.cpp
# SPEC_TO_INSPECTOR_VLM_URL=http://127.0.0.1:8131/v1
# SPEC_TO_INSPECTOR_VLM_MODEL=qwen3-vl-8b-instruct
# SPEC_TO_INSPECTOR_VLM_TIMEOUT_SECONDS=120

# The card the judge's server is on, as xpu-smi takes it: an index, or a PCI address, which
# ZE_AFFINITY_MASK does not renumber. On the B70 machine the judge's card is:
# SPEC_TO_INSPECTOR_VLM_CARD=0000:ba:00.0
# The default is the first card, which on that machine is the anomaly model's:
# SPEC_TO_INSPECTOR_VLM_CARD=0
# The container scripts/serve_vlm_xpu.sh starts the judge's server in.
# SPEC_TO_INSPECTOR_VLM_CONTAINER=spec-to-inspector-vlm

# The record of the checkpoints the Stage II protocol names by SHA-256: a run on xpu is held to it,
# and on any other checkpoint is void. The machine's rsync leaves results/ out, so it is copied over.
# SPEC_TO_INSPECTOR_CHECKPOINT_RECORD=results/stage2/checkpoints.json

# What the judge's reason may hold: no_digits, the final figure's rule, or designators, the Stage II
# protocol's declared comparison.
# SPEC_TO_INSPECTOR_REASON_RULE=no_digits
# The protocol a bench's figures follow; unset, the stage's under eval/.
# SPEC_TO_INSPECTOR_PROTOCOL_FILE=

# The corrections store: unset, corrections.sqlite3 under the runs directory. When its corrections
# are put before the judge: part or answer.
# SPEC_TO_INSPECTOR_CORRECTIONS_DB=
# SPEC_TO_INSPECTOR_CORRECTIONS_RECALL=part
